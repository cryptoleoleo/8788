{
  "manifest_version": 3,
  "name": "BAW Multiwallet 侧边栏",
  "version": "1.4.1",
  "description": "在 Chrome 侧边栏显示 BAW，并跟随 GMGN / Debot 的 BSC 代币 URL 识别 CA。",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://gmgn.ai/*",
    "https://www.gmgn.ai/*",
    "https://debot.ai/*",
    "https://www.debot.ai/*"
  ],
  "action": {
    "default_title": "在侧边栏打开 BAW Multiwallet"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://www.gmgn.ai/*",
        "https://debot.ai/*",
        "https://www.debot.ai/*"
      ],
      "js": [
        "token-url.js",
        "gmgn-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8787; frame-src http://127.0.0.1:8787;"
  },
  "key": ""
}
